<style>
  :root{--black:#0F0F0F;--gold:#F0B429;--grey:#6b6b6b;--line:#e6e6e6;}
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{font-family:'Inter',sans-serif;color:var(--black);background:#fff;line-height:1.5;}
  .page{max-width:880px;margin:0 auto;}
  header{background:var(--black);color:#fff;padding:52px 48px;}
  .kicker{color:var(--gold);font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;}
  h1{font-family:'Playfair Display',serif;font-size:48px;line-height:1.05;margin:12px 0 16px;}
  h1 span{color:var(--gold);}
  .sub{color:#cfcfcf;font-size:15.5px;max-width:600px;}
  .bar{display:flex;background:var(--gold);flex-wrap:wrap;}
  .bar div{flex:1;min-width:120px;padding:18px 12px;text-align:center;border-right:1px solid rgba(0,0,0,.12);}
  .bar div:last-child{border:0;}
  .bar b{display:block;font-size:22px;font-weight:800;font-family:'Playfair Display',serif;}
  .bar span{font-size:9.5px;text-transform:uppercase;letter-spacing:.09em;font-weight:600;}
  section{padding:38px 48px 0;}
  h2{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--grey);font-weight:600;
     border-bottom:2px solid var(--gold);padding-bottom:8px;margin-bottom:18px;}
  p{font-size:14.5px;margin-bottom:12px;}
  .lead{font-size:16.5px;}
  .lead strong{background:linear-gradient(transparent 62%, rgba(240,180,41,.45) 62%);}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .who li{list-style:none;font-size:14px;padding:7px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;}
  .who li b{color:var(--grey);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;}
  .who li span{text-align:right;}
  .why div{margin-bottom:16px;}
  .why h3{font-size:15px;font-weight:800;margin-bottom:3px;}
  .why h3 em{color:var(--gold);font-style:normal;margin-right:7px;}
  .why p{font-size:13.5px;color:#333;margin:0;}

  .inv{background:#faf9f7;border-left:3px solid var(--gold);padding:22px 26px;}
  .inv p{font-size:14.5px;margin:0;}
  .slots{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;}
  .slot{flex:1;min-width:150px;background:#fff;border:1px solid var(--line);padding:13px;text-align:center;}
  .slot b{display:block;font-size:13px;font-weight:800;margin-bottom:2px;}
  .slot span{font-size:11px;color:var(--grey);}
  .slot.na{background:var(--black);border-color:var(--black);}
  .slot.na b{color:var(--gold);} .slot.na span{color:#aaa;}

  .m3{background:var(--black);color:#fff;padding:28px 32px;}
  .m3 h3{font-family:'Playfair Display',serif;font-size:22px;margin-bottom:10px;}
  .m3 h3 b{color:var(--gold);}
  .m3 p{color:#cfcfcf;font-size:14px;margin:0;}
  .m3 em{color:#fff;}
  .m3 .kick{margin-top:12px;color:#fff;font-weight:600;font-size:14.5px;}

  .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:4px;}
  .tier{border:1px solid var(--line);padding:20px 18px;display:flex;flex-direction:column;}
  .tier.hero{border:2px solid var(--gold);background:#fffaf0;}
  .tier .sn{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:#b58519;font-weight:700;}
  .tier h3{font-size:19px;font-weight:800;margin:5px 0 3px;font-family:'Playfair Display',serif;}
  .tier .ex{font-size:11.5px;color:var(--grey);margin-bottom:12px;}
  .tier .amt{font-size:26px;font-weight:800;font-family:'Playfair Display',serif;line-height:1;}
  .tier .per{font-size:11.5px;color:var(--grey);margin-bottom:14px;}
  .tier ul{margin:0;padding-left:16px;}
  .tier li{font-size:12.6px;color:#333;margin-bottom:5px;}
  .tier li b{font-weight:700;}
  .alt{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}
  .alt div{border:1px solid var(--line);padding:16px 18px;}
  .alt h4{font-size:14.5px;font-weight:800;margin-bottom:3px;}
  .alt small{color:var(--grey);font-size:12px;display:block;margin-bottom:8px;}
  .alt p{font-size:12.8px;color:#333;margin:0;}

  .deeper{text-align:center;margin:34px 48px 0;padding:26px;border:1px dashed var(--gold);background:#fffdf7;}
  .deeper p{font-size:14.5px;margin-bottom:12px;}
  .btn{display:inline-block;background:var(--black);color:#fff;text-decoration:none;font-weight:700;
       font-size:13px;letter-spacing:.09em;text-transform:uppercase;padding:14px 30px;}
  .btn:hover{background:var(--gold);color:var(--black);}
  .btn.gold{background:var(--gold);color:var(--black);border:0;cursor:pointer;font-family:'Inter',sans-serif;}
  .btn.gold:hover{background:#fff;outline:2px solid var(--gold);}

  form{margin-top:20px;}
  .frow{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .f{margin-bottom:14px;}
  label{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;
        color:var(--grey);margin-bottom:5px;}
  input,select,textarea{width:100%;font-family:'Inter',sans-serif;font-size:14px;padding:11px 12px;
        border:1px solid var(--line);background:#fafafa;color:var(--black);}
  input:focus,select:focus,textarea:focus{outline:0;border-color:var(--gold);background:#fff;}
  textarea{min-height:96px;resize:vertical;}
  .hp{position:absolute;left:-9999px;}
  .fine{font-size:11.5px;color:var(--grey);margin-top:10px;}

  footer{margin:44px 48px 0;background:var(--black);color:#fff;padding:32px 34px;text-align:center;}
  footer .q{font-family:'Playfair Display',serif;font-size:22px;margin-bottom:12px;}
  footer .q b{color:var(--gold);}
  footer a{color:var(--gold);text-decoration:none;font-weight:600;}
  footer p{font-size:13px;color:#bdbdbd;margin:0;}

  @media(max-width:760px){
    header,section,.deeper,footer{padding-left:24px;padding-right:24px;margin-left:0;margin-right:0;}
    h1{font-size:34px;}
    .grid,.tiers,.alt,.frow{grid-template-columns:1fr;}
  }
</style>
</head>
<body>
<div class="page">

<header>
  <div class="kicker">Sponsorship &amp; Partnerships · 2026</div>
  <h1>Partner With The <span>Misfit</span> Entrepreneur</h1>
  <p class="sub">Ten years. 460+ episodes. 100+ countries. Hosted by a six-time Inc. 5000 founder with multiple eight- and nine-figure exits.</p>
</header>

<div class="bar">
  <div><b>20–30K</b><span>Per Episode</span></div>
  <div><b>460+</b><span>Episodes</span></div>
  <div><b>100+</b><span>Countries</span></div>
  <div><b>10 yrs</b><span>Unbroken</span></div>
  <div><b>10K</b><span>Newsletter</span></div>
  <div><b>Top 25</b><span>Entrepreneurship</span></div>
</div>

<section>
  <h2>The Pitch</h2>
  <p class="lead">Most shows sell impressions. <strong>Misfit sells a decade of compounded trust.</strong> Dave M. Lukas has built and sold software companies, hit the Inc. 5000 six times, and retired before forty. Misfit Nation doesn't tune in to be entertained — they tune in because Dave has already done what they're trying to do. When he recommends a product, it lands like advice from a peer with nothing to sell and no reason to shill.</p>
</section>

<section>
  <h2>Three Slots. Three Sponsors. That's All There Is.</h2>
  <div class="inv">
    <p>We don't stack advertisers. There are exactly <b>three sponsor positions</b> in a Misfit episode, and each partner owns one outright. Your message never competes with another brand's — because there isn't another brand in your slot.</p>
    <div class="slots">
      <div class="slot"><b>Pre-Roll</b><span>Opens the episode</span></div>
      <div class="slot"><b>Mid-Roll</b><span>Peak engagement</span></div>
      <div class="slot na"><b>The Misfit 3</b><span>Presented by you</span></div>
    </div>
  </div>
</section>

<section>
  <div class="m3">
    <h3>What is <b>The Misfit 3?</b></h3>
    <p>Dave started this show to collect wisdom for his daughter — so she could learn from her father and his misfit friends long after he's gone. Every single episode ends the same way: <em>"If you left this earth tomorrow, what are the three pieces of wisdom you'd leave behind?"</em></p>
    <p style="margin-top:10px;">It is the most-listened, most-clipped, most-quoted segment of the show. Nobody drops off before The Misfit 3. It's why they came.</p>
    <p class="kick">One partner presents it. Every week. That's a naming right, not an ad read.</p>
  </div>
</section>

<section class="grid">
  <div>
    <h2>Misfit Nation</h2>
    <ul class="who">
      <li><b>Who</b><span>Founders, owners, C-suite, investors</span></li>
      <li><b>Stage</b><span>$500K–$50M revenue operators</span></li>
      <li><b>Authority</b><span>Budget holders, not aspirants</span></li>
      <li><b>Buys</b><span>SaaS, fintech, education, coaching</span></li>
      <li><b>Reach</b><span>Audio · YouTube · Email · Social · Web</span></li>
    </ul>
  </div>
  <div class="why">
    <h2>Why It Converts</h2>
    <div><h3><em>01</em>Host-read. Always.</h3><p>No programmatic. No pre-recorded drops. Dave reads every spot in his own words, after using the product.</p></div>
    <div><h3><em>02</em>Your ad never expires.</h3><p>Show-notes placement is permanent. 2017 episodes still pull downloads. Your sponsorship keeps working long after the invoice clears.</p></div>
    <div><h3><em>03</em>He'll say no.</h3><p>Dave declines products he wouldn't use. That's not marketing copy — it's the mechanism behind the conversion rate.</p></div>
    <div><h3><em>04</em>Real numbers.</h3><p>Unique trackable URL, unique promo code, monthly reporting. No black boxes.</p></div>
  </div>
</section>

<section>
  <h2>Partnership Tiers</h2>
  <div class="tiers">
    <div class="tier hero">
      <div class="sn">Slot 01 · Pre-Roll</div>
      <h3>Founding Partner</h3>
      <div class="ex">Category exclusive · 1 of 1 · Annual</div>
      <div class="amt">$60,000</div>
      <div class="per">per year · $5,500/mo</div>
      <ul>
        <li><b>60-sec host-read pre-roll</b>, all 52 episodes</li>
        <li><b>Category exclusivity</b> — no competitor sponsors Misfit</li>
        <li><b>Exclusive newsletter banner</b>, 10K subscribers. Not sold at any other tier.</li>
        <li>Dedicated solo episode, 1x/year</li>
        <li>Custom case study, published permanently</li>
        <li>Homepage banner + logo</li>
        <li>4x/week social · 2 dedicated emails/yr</li>
        <li>Quarterly strategy call with Dave</li>
      </ul>
    </div>
    <div class="tier">
      <div class="sn">Slot 03 · The Misfit 3</div>
      <h3>Presenting Partner</h3>
      <div class="ex">Naming right · 1 of 1</div>
      <div class="amt">$48,000</div>
      <div class="per">per year · $4,400/mo</div>
      <ul>
        <li><b>"The Misfit 3, presented by [You]"</b> — spoken credit, every episode</li>
        <li>60-sec host-read lead-in</li>
        <li><b>Named in every Misfit 3 clip</b> cut for Shorts and Reels</li>
        <li>Permanent show-notes feature</li>
        <li>3x/week social</li>
        <li>1 dedicated email per quarter</li>
        <li>YouTube link + pinned comment</li>
      </ul>
    </div>
    <div class="tier">
      <div class="sn">Slot 02 · Mid-Roll</div>
      <h3>Feature Sponsor</h3>
      <div class="ex">Quarterly minimum · 13 episodes</div>
      <div class="amt">$3,200</div>
      <div class="per">per month · $36,000/yr</div>
      <ul>
        <li><b>60-sec host-read mid-roll</b> at peak engagement</li>
        <li>Permanent show-notes feature, for life</li>
        <li>Newsletter mention during term</li>
        <li>2x/week social promotion</li>
        <li>YouTube description link</li>
        <li>Trackable link + promo code</li>
        <li>Monthly reporting</li>
      </ul>
    </div>
  </div>

  <div class="alt">
    <div>
      <h4>Performance Partner</h4>
      <small>$1,250/mo base + 20–40% revenue share · Any open slot</small>
      <p>For brands with strong affiliate economics. Reduced base held against performance, commission on tracked conversions. The highest-upside structure for both sides — and the one we most want to run with a genuinely great product.</p>
    </div>
    <div>
      <h4>Spotlight — À la carte</h4>
      <small>Launches, events, and seasonal pushes</small>
      <p>Single pre-roll $850 · mid-roll $750 · Misfit 3 presentation $1,100 · Dedicated solo episode $7,500 · Dedicated email $2,500 · Sponsored Reel $850 · Permanent case-study page $3,000</p>
    </div>
  </div>
</section>

<div class="deeper">
  <p><b>Want the full picture?</b> Audience breakdown, distribution footprint, onboarding process, and what we ask of partners.</p>
  <a class="btn" href="/partner/kit">Read the Full Media Kit →</a>
</div>

<section id="inquire">
  <h2>Start the Conversation</h2>
  <p>Tell us what you're trying to accomplish. Dave reads every one of these. If it's not a fit, we'll tell you — and point you somewhere better.</p>

  <form name="sponsor-inquiry" method="POST" data-netlify="true" netlify-honeypot="company-website" action="/partner/thanks">
    <input type="hidden" name="form-name" value="sponsor-inquiry">
    <p class="hp"><label>Leave this blank: <input name="company-website"></label></p>

    <div class="frow">
      <div class="f"><label for="name">Your Name</label><input id="name" name="name" type="text" required></div>
      <div class="f"><label for="company">Company</label><input id="company" name="company" type="text" required></div>
    </div>
    <div class="frow">
      <div class="f"><label for="email">Email</label><input id="email" name="email" type="email" required></div>
      <div class="f"><label for="website">Website</label><input id="website" name="website" type="text" placeholder="https://"></div>
    </div>
    <div class="frow">
      <div class="f">
        <label for="tier">Slot of Interest</label>
        <select id="tier" name="tier">
          <option>Not sure yet — advise me</option>
          <option>Founding Partner — Pre-Roll, category exclusive</option>
          <option>Presenting Partner — The Misfit 3</option>
          <option>Feature Sponsor — Mid-Roll</option>
          <option>Performance Partner — base + revenue share</option>
          <option>Spotlight — single placements</option>
        </select>
      </div>
      <div class="f">
        <label for="budget">Budget Range</label>
        <select id="budget" name="budget">
          <option>Prefer to discuss</option>
          <option>Under $10,000</option>
          <option>$10,000 – $25,000</option>
          <option>$25,000 – $50,000</option>
          <option>$50,000+</option>
          <option>Performance-based only</option>
        </select>
      </div>
    </div>
    <div class="f">
      <label for="message">What are you trying to accomplish?</label>
      <textarea id="message" name="message" required placeholder="Who's your ideal customer? What does a win look like? Anything we should know."></textarea>
    </div>
    <button class="btn gold" type="submit">Send to Dave</button>
    <p class="fine">Goes directly to dave@misfitentrepreneur.com. Typically a reply within two business days.</p>
  </form>
</section>

<footer>
  <div class="q">Ready to unleash your organization's <b>inner misfit?</b></div>
  <p><a href="https://misfitentrepreneur.com">MisfitEntrepreneur.com</a> &nbsp;·&nbsp; Dave M. Lukas, Host &nbsp;·&nbsp; Rates effective January 1, 2026</p>
</footer>

</div>
</body>
</html>
